[flake8]
max-line-length = 100
max-complexity = 10

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    firmware/sdk,
    .pytest_cache,
    .mypy_cache

# E501: line too long (handled by black)
# W503: line break before binary operator (conflicts with black)
# E203: whitespace before ':' (conflicts with black)
# C901: too complex (we handle with max-complexity)
ignore =
    E501,
    W503,
    E203,
    C901

per-file-ignores =
    # Allow unused imports in __init__.py
    python/feralrf/__init__.py: F401
    # Allow assert in tests
    python/tests/*: S101
